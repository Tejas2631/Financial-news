# Normally created for you by ./setup.sh. Copy to .env and edit if you prefer to do it by hand.
DOMAIN=news.example.com                  # DNS A record of this name must point to the server
AUTH_USER=admin
AUTH_HASH='paste output of: docker run --rm caddy:2 caddy hash-password --plaintext "your-password"'   # keep the single quotes
API_KEY=long-random-string               # for your website / scripts:  X-API-Key header, read-only
CORS_ORIGINS=https://your-site.com       # sites allowed to call the API from a browser (* = any)
APP_UID=1000                             # owner of ./data  (run: id -u)
APP_GID=1000                             # (run: id -g)
